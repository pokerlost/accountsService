ACCOUNTSSERVICE_ROOT_OPERATION=accounts.getRoot
ACCOUNTSSERVICE_OPENAPI_OPERATION=openapi.get

ACCOUNTSSERVICE_APPLICATION__ENVIRONMENT=development
ACCOUNTSSERVICE_APPLICATION__VERSION=0.1.0
ACCOUNTSSERVICE_HTTP__HOST=127.0.0.1
ACCOUNTSSERVICE_HTTP__PORT=8000

ACCOUNTSSERVICE_LOGFIRE__ENABLED=true
ACCOUNTSSERVICE_LOGFIRE__SEND_TO_LOGFIRE=false
ACCOUNTSSERVICE_LOGFIRE__CONSOLE=true
ACCOUNTSSERVICE_LOGFIRE__MINIMUM_LEVEL=info
# ACCOUNTSSERVICE_LOGFIRE__TOKEN=replace-with-a-Logfire-write-token

# Local development only. Replace the placeholder; never reuse it outside a local database.
ACCOUNTSSERVICE_DATABASE__URL=postgresql+asyncpg://accountsservice:replace-with-local-password@127.0.0.1:5432/accountsservice
ACCOUNTSSERVICE_DATABASE__POOL_SIZE=5
ACCOUNTSSERVICE_DATABASE__MAX_OVERFLOW=5
ACCOUNTSSERVICE_DATABASE__POOL_TIMEOUT_SECONDS=10
ACCOUNTSSERVICE_DATABASE__COMMAND_TIMEOUT_SECONDS=10

ACCOUNTSSERVICE_PASSWORD__ARGON2_MEMORY_COST=65536
ACCOUNTSSERVICE_PASSWORD__ARGON2_TIME_COST=3
ACCOUNTSSERVICE_PASSWORD__ARGON2_PARALLELISM=4
ACCOUNTSSERVICE_PASSWORD__ARGON2_HASH_LENGTH=32
ACCOUNTSSERVICE_PASSWORD__ARGON2_SALT_LENGTH=16
ACCOUNTSSERVICE_PASSWORD__MIN_LENGTH=12
ACCOUNTSSERVICE_PASSWORD__MAX_LENGTH=256
