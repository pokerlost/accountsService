# Deployment environment is independent from Git branches and telemetry.
ACCOUNTSSERVICE_RUNTIME_ENVIRONMENT=local
# Execution contour for telemetry: local, dev, ci or remote.
ACCOUNTSSERVICE_ENVIRONMENT=local
# Example values only. The application does not load this file automatically.
ACCOUNTSSERVICE_LOGLEVEL=INFO
DATABASE_URL=postgresql+asyncpg://accountsservice:replace-with-local-password@127.0.0.1:5432/accountsservice
